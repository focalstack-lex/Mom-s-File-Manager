{
  "name": "tote",
  "private": true,
  "version": "0.3.0",
  "description": "Tote: finds a teacher's files and files the ones she sends it with one right-click.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "tauri dev",
    "dev:ui": "vite",
    "build": "tsc && vite build",
    "build:release": "tauri build",
    "release": "node scripts/release.mjs",
    "preview": "vite preview",
    "tauri": "tauri",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "verify:contrast": "node scripts/verify-contrast.mjs",
    "verify:text": "node scripts/verify-text.mjs",
    "verify:ui": "node scripts/verify-ui.mjs",
    "verify:native": "node scripts/verify-native.mjs",
    "verify": "npm run typecheck && npm run lint && npm run verify:text && npm test && npm run verify:contrast",
    "verify:all": "npm run verify && npm run verify:ui"
  },
  "dependencies": {
    "@fontsource/atkinson-hyperlegible-next": "^5.3.0",
    "@tauri-apps/api": "^2.12.1",
    "@tauri-apps/plugin-dialog": "^2.8.2",
    "lucide-react": "^1.49.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tauri-apps/cli": "^2.12.1",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "playwright": "^1.63.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  }
}
