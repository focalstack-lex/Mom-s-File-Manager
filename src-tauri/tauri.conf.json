{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tote",
  "version": "0.2.1",
  "identifier": "com.focalstack.tote",
  "build": {
    "beforeDevCommand": "npm run dev:ui",
    "devUrl": "http://localhost:1430",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: asset: http://asset.localhost; style-src 'self' 'unsafe-inline'; font-src 'self' data:; script-src 'self'",
      "devCsp": "default-src 'self' ws://localhost:1430; img-src 'self' data: asset: http://asset.localhost; style-src 'self' 'unsafe-inline'; font-src 'self' data:; script-src 'self' 'unsafe-inline'",
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$DESKTOP/**",
          "$DOCUMENT/**",
          "$DOWNLOAD/**",
          "$HOME/OneDrive/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "createUpdaterArtifacts": true,
    "resources": {
      "../THIRD-PARTY-NOTICES.txt": "THIRD-PARTY-NOTICES.txt",
      "../LICENSE": "LICENSE.txt"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDNFQzhCQkVBNTMxQzcyQzcKUldUSGNoeFQ2cnZJUHRjS3YrSVVPV2hGMkpuTmg4S1pKWkF5eXY5TytZcTBlcXRtZ0VNNGxocXcK",
      "endpoints": [
        "https://www.codewithlex.site/tote/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
